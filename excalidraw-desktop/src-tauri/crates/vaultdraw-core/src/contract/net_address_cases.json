      "want": "INVALID_URL"
    },
    {
      "url": "http://[fd00::5]:11434/x",
      "allow": [
        "[fd00::5]:11434"
      ],
      "want": "ok"
    },
    {
      "url": "http://169.254.169.254/x",
      "allow": [
        "192.168.1.20"
      ],
      "want": "PRIVATE_ADDRESS"
    }
  ]
